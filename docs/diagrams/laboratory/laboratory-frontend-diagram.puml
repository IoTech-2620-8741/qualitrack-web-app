@startuml laboratory-frontend-diagram

title QualiTrack - Laboratory Frontend Class Diagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "shared" {
  class PageHeader <<component>>
  interface PageTab
  class ListToolbar <<component>>
  class TablePaginator <<component>>
  class FilterChip <<component>>
  class DateTimePipe <<pipe>>
  class ErrorHandlingEnabledBaseType
  interface BaseEntity
  class BaseApi
  class BaseApiEndpoint
  class errorStatus <<function>>
  interface BaseAssembler
}

package "iam.application" {
  class IamStore {
    +requireLaboratoryId(): number
    +canManageQuality: Signal<boolean>
    +currentUserId: Signal<number | null>
  }
}

package "laboratory.domain.model" {
  class Laboratory {
    +id: number
    +name: string
    +ruc: string
    +address: string
    +phone: string
    +applicableRegulations: string[]
  }
  class StaffMember {
    +id: number
    +laboratoryId: number
    +fullName: string
    +role: string
    +email: string
    +active: boolean
    +accessRole: StaffAccessRole | null
    +userId: number | null
    +assignable: boolean
  }
  enum StaffAccessRole {
    OPERATOR
    AUDITOR
  }
  class StaffCredentials <<type>> {
    +username: string
    +delivery: 'EMAIL' | 'SHOWN_ONCE'
    +temporaryPassword: string | null
  }
  class RegisteredStaff <<type>> {
    +staffMember: StaffMember
    +credentials: StaffCredentials
  }
  class Environment {
    +id: number
    +laboratoryId: number
    +code: string
    +name: string
    +description: string | null
    +usage: EnvironmentUsage | null
  }
  enum EnvironmentUsage {
    LABORATORY
    PRODUCTION
    RAW_MATERIAL_STORAGE
    PRODUCT_STORAGE
    OTHER
  }
  class StaffMemberProfile {
    +id: number
    +username: string
    +email / fullName / dni / phoneNumber / location: string | null
    +hasPhoto: boolean
    +updatedAt: string | null
  }
  class StaffActivityEntry {
    +id: number
    +action: string
    +entityType: string
    +entityId: number
    +timestamp: string
  }
  interface CreateLaboratoryCommand
  interface UpdateLaboratoryCommand
  interface RegisterStaffCommand
  interface RegisterEnvironmentCommand
  interface UpdateEnvironmentCommand
}

Laboratory ..|> BaseEntity
StaffMember ..|> BaseEntity
StaffMember --> StaffAccessRole
RegisteredStaff --> StaffMember
RegisteredStaff --> StaffCredentials
Environment ..|> BaseEntity
Environment --> EnvironmentUsage
StaffMemberProfile ..|> BaseEntity
StaffActivityEntry ..|> BaseEntity

package "laboratory.infrastructure" {
  class LaboratoryApi {
    +createLaboratory(request)
    +getLaboratory(laboratoryId)
    +updateLaboratory(laboratoryId, request)
    +getStaff(laboratoryId)
    +getStaffMember(laboratoryId, staffId)
    +registerStaff(laboratoryId, request): Observable<RegisteredStaff>
    +deactivateStaff(laboratoryId, staffId): Observable<StaffMember>
    +getStaffProfile(laboratoryId, staffId): Observable<StaffMemberProfile>
    +getStaffPhoto(laboratoryId, staffId): Observable<Blob>
    +getStaffActivity(laboratoryId, staffId): Observable<StaffActivityEntry[]>
    +getEnvironments(laboratoryId)
    +getEnvironment(laboratoryId, environmentId)
    +createEnvironment(laboratoryId, request)
    +updateEnvironment(laboratoryId, environmentId, request)
    +assignUsage(laboratoryId, environmentId, request)
  }
  class LaboratoryApiEndpoint
  class StaffApiEndpoint
  class EnvironmentApiEndpoint
  class LaboratoryAssembler
  class StaffAssembler
  class EnvironmentAssembler
  class StaffProfileApiEndpoint {
    +getStaffProfile(laboratoryId, staffId)
    +getStaffPhoto(laboratoryId, staffId)
  }
  interface StaffProfileResource
  class StaffProfileAssembler
  class StaffActivityApiEndpoint {
    +getStaffActivity(laboratoryId, staffId)
  }
  interface StaffActivityEntryResource
  class StaffActivityAssembler
}

LaboratoryApi --|> BaseApi
LaboratoryApi --> LaboratoryApiEndpoint
LaboratoryApi --> StaffApiEndpoint
LaboratoryApi --> EnvironmentApiEndpoint
LaboratoryApiEndpoint --|> BaseApiEndpoint
StaffApiEndpoint --|> BaseApiEndpoint
EnvironmentApiEndpoint --|> BaseApiEndpoint
LaboratoryApiEndpoint --> LaboratoryAssembler
StaffApiEndpoint --> StaffAssembler
EnvironmentApiEndpoint --> EnvironmentAssembler
note bottom of StaffApiEndpoint
  GET/POST /laboratories/{laboratoryId}/staff, GET .../staff/{staffId},
  POST .../staff/{staffId}/deactivations
end note
LaboratoryApi --> StaffProfileApiEndpoint
LaboratoryApi --> StaffActivityApiEndpoint
StaffProfileApiEndpoint --|> ErrorHandlingEnabledBaseType
StaffActivityApiEndpoint --|> ErrorHandlingEnabledBaseType
StaffProfileApiEndpoint --> StaffProfileAssembler
StaffProfileAssembler ..> StaffProfileResource
StaffProfileAssembler ..> StaffMemberProfile
StaffActivityApiEndpoint --> StaffActivityAssembler
StaffActivityAssembler ..> StaffActivityEntryResource
StaffActivityAssembler ..> StaffActivityEntry
note bottom of StaffProfileApiEndpoint
  Anti-corruption layers of Laboratory: Profile owns
  GET .../staff/{staffId}/profile[/photo] and Reporting & Audit owns
  GET .../staff/{staffId}/audit-logs; Laboratory keeps only what the
  staff detail shows, in models of its own.
end note

package "laboratory.application" {
  class LaboratoryStore {
    +laboratory: Signal<Laboratory>
    +staffList: Signal<StaffMember[]>
    +activeStaff
    +loadLaboratory(laboratoryId)
    +createLaboratory(command)
    +updateLaboratory(laboratoryId, command)
    +loadStaff(laboratoryId)
    +staffMember(laboratoryId, staffId): Observable<StaffMember>
    +registerStaff(laboratoryId, command): Observable<RegisteredStaff>
    +deactivateStaff(laboratoryId, staffId): Observable<StaffMember>
    +staffProfile(laboratoryId, staffId): Observable<StaffProfile>
    +staffPhoto(laboratoryId, staffId): Observable<string | null>
    +staffActivity(laboratoryId, staffId): Observable<StaffActivityEntry[]>
    +environments: Signal<Environment[]>
    +environmentsLoading / environmentError / environmentsEmpty
    +canManageEnvironments: Signal<boolean>
    +loadEnvironments()
    +loadEnvironment(environmentId)
    +registerEnvironment(command)
    +updateEnvironment(environmentId, command)
    +assignEnvironmentUsage(environmentId, usage)
  }
  interface StaffProfile {
    +profile: StaffMemberProfile
    +photoUrl: string | null
  }
}
LaboratoryStore ..> StaffProfile

LaboratoryStore --> LaboratoryApi
LaboratoryStore --> IamStore
note right of LaboratoryStore
  Single store of the context (application/laboratory.store.ts).
  The other contexts read environments and staff through their
  own models; each one remembers its environment in this browser.
  The photos of the staff are downloaded once in the session and
  released when another person signs in.
end note

package "laboratory.presentation" {
  class "LABORATORY_TABS" as LaboratoryTabs <<const>>
  class LabForm
  class LabProfile
  class EnvironmentList
  class EnvironmentForm
  class StaffList
  class StaffForm
  class StaffDetail {
    #member / profile / activity
    #period / action / entityType
    #visibleActivity
  }
  class StaffAvatar <<component>>
  class "staff-activity-labels" as StaffActivityLabels <<functions>>
  class LaboratoryRoutes
}

LabForm --> LaboratoryStore
LabProfile --> LaboratoryStore
EnvironmentList --> LaboratoryStore
EnvironmentForm --> LaboratoryStore
StaffList --> LaboratoryStore
StaffForm --> LaboratoryStore
StaffForm ..> errorStatus
StaffForm ..> RegisteredStaff
StaffList --> IamStore
StaffDetail --> LaboratoryStore
note right of StaffForm
  Quality managers register operators and auditors; the credentials are e-mailed
  or shown once (username and temporary password) when the e-mail cannot be sent.
end note
StaffDetail --> IamStore
StaffDetail ..> StaffAvatar
StaffDetail ..> StaffActivityLabels
StaffDetail ..> ListToolbar
StaffDetail ..> FilterChip
StaffDetail ..> TablePaginator
StaffDetail ..> DateTimePipe
StaffList ..> StaffAvatar
StaffAvatar --> LaboratoryStore : staffPhoto
note right of StaffDetail
  The member, their account and deactivation, the profile with its photo
  (quality managers, members with an account) and the activity narrowed by
  period, action and type of record. /profile/staff/:staffId and
  /reports/staff/:staffId/activity redirect here. No Profile or
  Reporting & Audit code is imported: both are read through the
  anti-corruption layers of Laboratory.
end note

note bottom of LaboratoryRoutes
  /laboratories/profile, environments[/new|/:environmentId/edit],
  staff, staff/new (quality managers), staff/:staffId (quality managers and auditors),
  raw-materials/:id redirects to /inventory/legacy-materials/:id.
  product-catalog and product-form redirect to /batches/environments;
  raw-material-list and raw-material-form redirect to /inventory.
end note

note left of LaboratoryRoutes
  Source: laboratory/presentation/laboratory.routes.ts
  Public paths and guards remain unchanged.
end note

LaboratoryTabs ..> PageTab
LabProfile ..> PageHeader
LabProfile ..> LaboratoryTabs
EnvironmentList ..> PageHeader
EnvironmentList ..> ListToolbar
EnvironmentList ..> TablePaginator
EnvironmentList ..> LaboratoryTabs
StaffList ..> PageHeader
StaffList ..> ListToolbar
StaffList ..> TablePaginator
StaffList ..> LaboratoryTabs
note bottom of LaboratoryTabs
  Profile, Environments and Staff are the tabs of the page header of the
  laboratory. The code of an environment opens its equipment
  (/equipments/environments/:environmentId).
end note

@enduml
