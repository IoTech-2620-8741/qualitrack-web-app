@startuml ra-frontend-diagram

title QualiTrack - Reporting and Analysis Frontend Class Diagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "shared" {
  class EnvironmentSelector <<component>>
  interface BaseEntity
  class BaseApi
  class BaseApiEndpoint
  class ErrorHandlingEnabledBaseType
  interface BaseAssembler
  interface BaseResource
  interface BaseResponse
  class "localIsoDate()" as LocalIsoDate
}

package "iam.application" {
  class IamStore {
    +currentUserId()
    +currentLaboratoryId()
    +isSignedIn()
  }
}

package "equipment" {
  class EquipmentStore {
    +equipmentList
    +loadEquipment(labId: number): void
  }
  class EquipmentApi {
    +getEquipment(laboratoryId: number)
  }
}

package "batch.application" {
  class BatchStore {
    +batches
    +loadBatches(labId: number): void
  }
}

package "laboratory" {
  class EnvironmentStore {
    +environments
    +isEmpty
    +loadEnvironments(): Promise<void>
    +preferredEnvironment(usage?, scope): Environment
    +rememberEnvironment(environmentId, scope): void
  }
}

package "ra.domain.model" {
  class KpiDashboard {
    +id: number
    +laboratoryId: number
    +timestamp: string
    +overallHealthScore: number
    +from: string
    +to: string
    +metrics: KpiMetric[]
    +measurementSummaries: MeasurementSummary[]
  }

  interface MeasurementSummary {
    +environmentId: number
    +deviceId: number
    +metric: string
    +unit: string
    +readings: number
    +average: number
    +minimum: number
    +maximum: number
    +firstMeasuredAt: string
    +lastMeasuredAt: string
  }

  class KpiMetric {
    +id: number
    +name: string
    +value: number
    +unit: string
    +targetValue: number
    +status: "ON_TRACK | AT_RISK | CRITICAL | UNKNOWN"
    +recordedAt: string
  }

  class DeviationTrend {
    +id: number
    +parameterName: string
    +equipmentId: number
    +environmentId: number
    +unit: string
    +trendDirection: "STABLE | INCREASING | DECREASING"
    +evaluatedReadings: number
    +timeInRangePercent: number
    +deviationCount: number
    +criticalDeviationCount: number
    +dataPoints: DataPoint[]
  }

  interface DataPoint {
    +timestamp: string
    +recordedValue: number
    +upperThreshold: number
    +lowerThreshold: number
    +state: "NORMAL | WARNING | CRITICAL"
  }

  interface IndicatorPeriod {
    +from: string
    +to: string
  }

  class "lastDays(days)" as LastDays

  class AuditLogEntry {
    +id: number
    +action: AuditAction
    +entityType: string
    +entityId: number
    +performedBy: number
    +timestamp: string
    +details: string
  }

  interface GenerateBatchReportCommand {
    +batchId: number
    +includeDeviations: boolean
    +format: "PDF | CSV"
  }

  interface GenerateComplianceReportCommand {
    +laboratoryId: number
    +environmentId: number
    +startDate: string
    +endDate: string
    +format: "PDF | CSV"
  }

  interface GenerateInventoryReportCommand {
    +laboratoryId: number
    +environmentId: number
    +format: "PDF | CSV"
  }

  interface ExportEquipmentLogCommand {
    +laboratoryId: number
    +environmentId: number
    +equipmentId: number
    +startDate: string
    +endDate: string
    +format: "PDF | CSV"
  }

  class OverviewLaboratory {
    +id: number
    +name: string
  }
  class OverviewEquipment {
    +id / laboratoryId / environmentId
    +name: string
    +deviceType: string | null
    +isIotDevice: boolean
    +isContainerMonitor: boolean
  }
  class OverviewBatch {
    +id / batchNumber / productName / status
    +environmentId / productId
    +detailLink
  }
  class OverviewRawMaterial {
    +id / name / stockStatus
    +isLowStock: boolean
  }
  class OverviewAlert {
    +id / equipmentId / parameterName
    +recordedValue / unit / severity / status / timestamp
    +isOpen: boolean
  }
  class OverviewReading {
    +deviceId / metric / value / unit / measuredAt
    +isChartable: boolean
  }
  class OverviewSubscription {
    +laboratoryId / planCode / billingCycle / status
    +currentPeriodEnd: string | null
  }
  class OverviewPlan {
    +code / name / billingPeriod
    +priceAmount / currency
    +maxEquipment: number | null
  }
}

package "ra.infrastructure" {
  class RaApi {
    -_kpiEndpoint: KpiApiEndpoint
    -_deviationTrendEndpoint: DeviationTrendApiEndpoint
    -_auditLogEndpoint: AuditLogApiEndpoint
    -_reportEndpoint: ReportApiEndpoint

    +getDashboardByLaboratory(laboratoryId, period?, environmentId?)
    +getTrendsByEnvironment(laboratoryId, environmentId, period)
    +getAuditLog(laboratoryId: number, filters?)
    +getStaffActivity(laboratoryId: number, staffId: number)
    +generateBatchReport(request: GenerateBatchReportRequest)
    +generateComplianceReport(request: GenerateComplianceReportRequest)
    +generateInventoryReport(request: GenerateInventoryReportRequest)
    +exportEquipmentLog(request: ExportEquipmentLogRequest)
  }

  class KpiApiEndpoint {
    +getDashboardByLaboratory(laboratoryId, period?, environmentId?)
  }

  note bottom of KpiApiEndpoint
    GET /laboratories/{lab}/kpi-dashboards?from&to&environmentId (TS81)
  end note

  class DeviationTrendApiEndpoint {
    +getTrendsByEnvironment(laboratoryId, environmentId, period)
  }

  note bottom of DeviationTrendApiEndpoint
    GET /laboratories/{lab}/environments/{env}/deviation-trends?from&to (TS82)
  end note

  class AuditLogApiEndpoint {
    +getAuditLog(laboratoryId: number, filters?)
    +getStaffActivity(laboratoryId: number, staffId: number)
  }

  class ReportApiEndpoint {
    +generateBatchReport(request: GenerateBatchReportRequest)
    +generateComplianceReport(request: GenerateComplianceReportRequest)
    +generateInventoryReport(request: GenerateInventoryReportRequest)
    +exportEquipmentLog(request: ExportEquipmentLogRequest)
    -createAndDownload(url, body, fallback): Observable<Blob>
  }

  note bottom of ReportApiEndpoint
    POST creates the report (201 + Location /reports/{reportId}), then
    GET /reports/{reportId}/content downloads its PDF or CSV (TS83-TS87).
    Inventory: /laboratories/{lab}/inventory/reports (TS85).
    Equipment logs: /laboratories/{lab}/environments/{env}/equipments/{id}/log-reports.
  end note

  class KpiAssembler
  class DeviationTrendAssembler
  class AuditLogAssembler

  interface KpiMetricResource {
    +id: number
    +name: string
    +value: number
    +unit: string
    +targetValue: number
    +status: "ON_TRACK | AT_RISK | CRITICAL | UNKNOWN"
    +recordedAt: string
  }

  interface KpiDashboardResource {
    +id: number
    +laboratoryId: number
    +timestamp: string
    +overallHealthScore: number
    +from: string
    +to: string
    +metrics: KpiMetricResource[]
    +measurementSummaries: MeasurementSummary[]
  }

  interface KpiDashboardsResponse {
    +dashboards: KpiDashboardResource[]
  }

  interface DataPointResource {
    +timestamp: string
    +recordedValue: number
    +upperThreshold: number
    +lowerThreshold: number
    +state: "NORMAL | WARNING | CRITICAL"
  }

  interface DeviationTrendResource {
    +id: number
    +parameterName: string
    +equipmentId: number
    +environmentId: number
    +unit: string
    +trendDirection: "STABLE | INCREASING | DECREASING"
    +evaluatedReadings: number
    +timeInRangePercent: number
    +deviationCount: number
    +criticalDeviationCount: number
    +dataPoints: DataPointResource[]
  }

  interface DeviationTrendsResponse {
    +trends: DeviationTrendResource[]
  }

  interface AuditLogEntryResource {
    +id: number
    +action: AuditAction
    +entityType: string
    +entityId: number
    +performedBy: number
    +timestamp: string
    +details: string
  }

  interface AuditLogEntriesResponse {
    +auditLogs: AuditLogEntryResource[]
  }

  interface GenerateBatchReportRequest {
    +batchId: number
    +includeDeviations: boolean
    +format: "PDF | CSV"
  }

  interface GenerateComplianceReportRequest {
    +laboratoryId: number
    +environmentId: number
    +startDate: string
    +endDate: string
    +format: "PDF | CSV"
  }

  interface GenerateInventoryReportRequest {
    +laboratoryId: number
    +environmentId: number
    +format: "PDF | CSV"
  }

  interface ExportEquipmentLogRequest {
    +laboratoryId: number
    +environmentId: number
    +equipmentId: number
    +startDate: string
    +endDate: string
    +format: "PDF | CSV"
  }

  class OperationalOverviewApiEndpoint {
    +getLaboratory(laboratoryId)
    +getEnvironmentIds(laboratoryId)
    +getLowStockMaterials(laboratoryId, environmentId)
    +getBatches(laboratoryId)
    +getEquipment(laboratoryId)
    +getOpenAlerts(laboratoryId, environmentId)
    +getReadings(laboratoryId, environmentId, containerMonitorId, period)
    +getActiveSubscription(laboratoryId)
    +getPlans()
  }
  class OperationalOverviewAssembler
  note bottom of OperationalOverviewApiEndpoint
    Anti-Corruption Layer: reads the REST resources of Laboratory, Inventory,
    Product Batch, Equipment, Compliance & Alerting, Tracking & Telemetry and
    Payments & Subscriptions and translates them into the Overview* models.
  end note
}

package "ra.application" {
  class RaStore {
    -api: RaApi
    -equipmentApi: EquipmentApi
    -_dashboard
    -_deviationTrends
    -_devices
    -_auditLogs
    -_isLoading
    -_error
    -_successMsg

    +dashboard
    +deviationTrends
    +auditLogs
    +isLoading
    +error
    +successMsg

    +deviceName(deviceId: number): string
    +loadDevices(): void
    +loadDashboard(period: IndicatorPeriod, environmentId: number): void
    +loadDeviationTrends(environmentId: number, period: IndicatorPeriod): void
    +loadAuditLog(filters?): void
    +generateBatchReport(command: GenerateBatchReportCommand): void
    +generateComplianceReport(command: GenerateComplianceReportCommand): void
    +generateInventoryReport(command: GenerateInventoryReportCommand): void
    +exportEquipmentLog(command: ExportEquipmentLogCommand): void
    +clearMessages(): void

    +overviewLaboratory / overviewEquipment / overviewBatches
    +overviewMaterials / overviewAlerts / overviewMeasurements
    +overviewSubscription / overviewPlans: Signal<OverviewState>
    +overviewDevices / overviewOpenAlerts / overviewLowStock
    +overviewSeries / overviewReadings / overviewReadingRange
    +reloadOverview(): void
    +loadOverviewSubscription(): void
    +loadOverviewPlans(): void
    +loadOverviewAlerts(): void
    +selectOverviewDevice(deviceId: number | null): void
    +selectOverviewSeries(key: string): void
  }
}

package "ra.presentation" {
  class RaRoutes

  class Dashboard {
    #store: RaStore
    #summaryCards / batchDistribution / recentBatches
    #chartData / chartOptions
    #reloadAll(): void
  }

  class KpiDashboardComponent {
    +periods
    +days
    +environmentId
    +groups
    +ngOnInit(): Promise<void>
    +changePeriod(days: number): void
    +changeEnvironment(environmentId: number): void
    +reload(): void
  }

  note bottom of KpiDashboardComponent
    Environmental summary (US93): average, minimum and maximum
    per environment, device and variable of the last 24 hours,
    7 or 31 days; every environment or one. Without readings
    it states that nothing is calculated.
  end note

  class DeviationTrendChartComponent {
    +periods
    +days
    +environmentId
    +activeTrend
    +chartData
    +chartOptions
    +ngOnInit(): Promise<void>
    +changeEnvironment(environmentId: number): void
    +changePeriod(days: number): void
    +select(trend: DeviationTrend): void
  }

  note bottom of DeviationTrendChartComponent
    Deviation indicators (US94): time in range, deviations and
    critical deviations per device and variable, with the readings
    of the selected one colored by condition.
  end note

  class ReportGeneratorComponent {
    +batchForm
    +complianceForm
    +inventoryForm
    +equipmentForm
    +onGenerateBatchReport(): void
    +onGenerateComplianceReport(): void
    +onGenerateInventoryReport(): void
    +onExportEquipmentLog(): void
  }

  class AuditLogViewerComponent {
    +displayedColumns
    +filters
    +ngOnInit(): void
    +loadLogs(): void
    +clearFilters(): void
    +getActionBadgeClass(action): string
  }
}

KpiDashboard ..|> BaseEntity
KpiMetric ..|> BaseEntity
DeviationTrend ..|> BaseEntity
AuditLogEntry ..|> BaseEntity

KpiDashboard *-- KpiMetric
KpiDashboard *-- MeasurementSummary
DeviationTrend *-- DataPoint
LastDays ..> IndicatorPeriod

RaApi --|> BaseApi
KpiApiEndpoint --|> BaseApiEndpoint
DeviationTrendApiEndpoint --|> BaseApiEndpoint
AuditLogApiEndpoint --|> BaseApiEndpoint

KpiAssembler ..|> BaseAssembler
DeviationTrendAssembler ..|> BaseAssembler
AuditLogAssembler ..|> BaseAssembler

KpiDashboardResource ..|> BaseResource
KpiDashboardsResponse ..|> BaseResponse
DeviationTrendResource ..|> BaseResource
DeviationTrendsResponse ..|> BaseResponse
AuditLogEntryResource ..|> BaseResource
AuditLogEntriesResponse ..|> BaseResponse

RaStore --> RaApi
RaStore --> EquipmentApi : device names
RaStore --> IamStore

RaStore ..> KpiDashboard
RaStore ..> DeviationTrend
RaStore ..> AuditLogEntry
RaStore ..> IndicatorPeriod
RaStore ..> GenerateBatchReportCommand
RaStore ..> GenerateComplianceReportCommand
RaStore ..> GenerateInventoryReportCommand
RaStore ..> ExportEquipmentLogCommand

RaApi --> KpiApiEndpoint
RaApi --> DeviationTrendApiEndpoint
RaApi --> AuditLogApiEndpoint
RaApi --> ReportApiEndpoint
RaApi --> OperationalOverviewApiEndpoint
OperationalOverviewApiEndpoint --|> ErrorHandlingEnabledBaseType
OperationalOverviewApiEndpoint --> OperationalOverviewAssembler
OperationalOverviewAssembler ..> OverviewLaboratory
OperationalOverviewAssembler ..> OverviewEquipment
OperationalOverviewAssembler ..> OverviewBatch
OperationalOverviewAssembler ..> OverviewRawMaterial
OperationalOverviewAssembler ..> OverviewAlert
OperationalOverviewAssembler ..> OverviewReading
OperationalOverviewAssembler ..> OverviewSubscription
OperationalOverviewAssembler ..> OverviewPlan
Dashboard --> RaStore

KpiApiEndpoint --> KpiAssembler
DeviationTrendApiEndpoint --> DeviationTrendAssembler
AuditLogApiEndpoint --> AuditLogAssembler

KpiApiEndpoint ..> KpiDashboardResource
KpiApiEndpoint ..> IndicatorPeriod
DeviationTrendApiEndpoint ..> DeviationTrendResource
DeviationTrendApiEndpoint ..> IndicatorPeriod
AuditLogApiEndpoint ..> AuditLogEntryResource

ReportApiEndpoint ..> GenerateBatchReportRequest
ReportApiEndpoint ..> GenerateComplianceReportRequest
ReportApiEndpoint ..> GenerateInventoryReportRequest
ReportApiEndpoint ..> ExportEquipmentLogRequest

KpiAssembler ..> KpiDashboard
KpiAssembler ..> KpiMetric
KpiAssembler ..> KpiDashboardResource
DeviationTrendAssembler ..> DeviationTrend
DeviationTrendAssembler ..> DeviationTrendResource
AuditLogAssembler ..> AuditLogEntry
AuditLogAssembler ..> AuditLogEntryResource

KpiDashboardComponent --> RaStore
KpiDashboardComponent --> EnvironmentStore
KpiDashboardComponent ..> LastDays

DeviationTrendChartComponent --> RaStore
DeviationTrendChartComponent --> EnvironmentStore
DeviationTrendChartComponent --> EnvironmentSelector
DeviationTrendChartComponent ..> LastDays

ReportGeneratorComponent --> RaStore
ReportGeneratorComponent --> IamStore
ReportGeneratorComponent --> BatchStore
ReportGeneratorComponent --> EquipmentStore
ReportGeneratorComponent --> EnvironmentStore
ReportGeneratorComponent ..> LocalIsoDate : report days

AuditLogViewerComponent --> RaStore

RaRoutes ..> KpiDashboardComponent
RaRoutes ..> DeviationTrendChartComponent
RaRoutes ..> ReportGeneratorComponent
RaRoutes ..> AuditLogViewerComponent

@enduml
