@startuml shared-frontend-diagram
title QualiTrack - Shared Frontend

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "external bounded contexts" <<External>> {
  class IamStore
  class AuthenticationSection
}

package "app (composition root)" <<External>> {
  class App
  class appConfig <<providers>>
}

package "shared" {

  package "domain.model" {
    interface BaseEntity {
      +id: number
    }
  }

  package "infrastructure" {
    interface BaseResource {
      +id: number
    }

    interface BaseResponse


    interface BaseAssembler<TEntity, TResource, TResponse> {
      +toEntityFromResource(resource: TResource): TEntity
      +toResourceFromEntity(entity: TEntity): TResource
      +toEntitiesFromResponse(response: TResponse): TEntity[]
    }

    abstract class BaseApi {
    }

    class ApiError {
      +status: number
      +details?: string
    }

    class EnvironmentPreference {
      +choose(laboratoryId, environments, preferredUsage?)
      +remember(laboratoryId, environmentId): void
      +read(laboratoryId): number | null
    }

    class errorStatus <<function>> {
      +errorStatus(error: unknown): number | null
    }

    abstract class ErrorHandlingEnabledBaseType {
      #handleError(operation: string): Function
    }

    abstract class BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler> {
      #http: HttpClient
      #endpointUrl: string
      #assembler: TAssembler
      +getAll(): Observable<TEntity[]>
      +getById(id: number): Observable<TEntity>
      +create(entity: TEntity): Observable<TEntity>
      +update(entity: TEntity, id: number): Observable<TEntity>
      +delete(id: number): Observable<void>
    }
  }

  package "presentation.components" {
    class EnvironmentSelector {
      +environments: InputSignal<EnvironmentOption[]>
      +selectedId: InputSignal<number | null>
      +allOptionKey: InputSignal<string | null>
      +selectedChange: OutputEmitterRef<number>
      +allSelected: OutputEmitterRef<void>
    }

    interface EnvironmentOption {
      +id: number
      +code: string
      +name: string
      +usage?: string | null
    }

    class LanguageSwitcher {
      #currentLang: string
      #languages: string[]
      #translate: TranslateService
      #compact: Signal<boolean>
      +useLanguage(language: string): void
    }

    class Layout {
      +isSignedIn: InputSignal<boolean>
      +hasOperationalAccess: InputSignal<boolean>
      +canManageQuality: InputSignal<boolean>
      #brandLink: Signal<string>
      #brandLabel: Signal<string>
      -router: Router
      #sidenavMode: 'side' | 'over'
      #sidenavOpened: boolean
      -sections: NavigationSection[]
      #visibleSections: Signal<NavigationSection[]>
      #navigateTo(link: string): void
      #isActive(link: string): boolean
      #activeChildLink(option): string | undefined
    }

    class EmptyState {
      +messageKey / titleKey / icon
      +positive: InputSignal<boolean>
    }
    class ErrorBanner
    class DashboardState
    class StatusChip {
      +tone / icon / labelKey
    }
    class StatFilterCard {
      +icon / labelKey / value
      +hintKey / hintParams / pressed
      +toggled: OutputEmitterRef<void>
    }
    class ActionBanner {
      +icon / tone / actionKey
      +action: OutputEmitterRef<void>
    }
    class SidePanel {
      +titleText / subtitle
      +trapFocus / focusTitleOnOpen
      +closed: OutputEmitterRef<void>
      +focusTitle(): void
    }
    class UndoToast {
      #paused / secondsLeft
      #undo(): void
    }
    class UndoToastOpener <<service>> {
      +open(data): Observable<UndoToastOutcome>
      +confirmNow(): void
    }
    class NavigationSection <<type>> {
      +title?: string
      +options: NavigationOption[]
    }

    class NavigationOption <<type>> {
      +label: string
      +icon: string
      +link: string
      +qualityOnly?: boolean
      +children?: NavigationChild[]
    }

    class NavigationChild <<type>> {
      +label: string
      +link: string
      +qualityOnly?: boolean
    }
    note bottom of NavigationChild
      Entries marked qualityOnly (subscription, equipment and staff registration)
      are only listed for quality managers.
    end note
  }

  package "presentation.pipes" {
    class DateTimePipe
    class RelativeTimePipe
    class ElapsedTimePipe
    class "date-time-format" as DateTimeFormat <<functions>>
  }

  package "presentation.views" {
    class Home {
    }

    class About {
    }

    class PageNotFound {
      #invalidPath: string
      #isSignedIn: Signal<boolean>
      -router: Router
      +ngOnInit(): void
      #goBack(): void
    }
  }

  package "presentation.tokens" {
    class SIGNED_IN <<InjectionToken<Signal<boolean>>>>
  }
}

BaseResource --|> BaseEntity
BaseApiEndpoint --|> ErrorHandlingEnabledBaseType
errorStatus ..> ApiError
note bottom of EnvironmentPreference
  Environment remembered in this browser per area (inventory, production,
  tracking) under qualitrack.environment.{laboratoryId}.{scope}; each
  bounded context passes its own environments.
end note
BaseApiEndpoint ..> BaseEntity
BaseApiEndpoint ..> BaseResource
BaseApiEndpoint ..> BaseResponse
BaseApiEndpoint ..> BaseAssembler

BaseAssembler ..> BaseEntity
BaseAssembler ..> BaseResource
BaseAssembler ..> BaseResponse

package "iam.presentation.components" <<External>> {
  class UserSessionSection
}

package "profile.presentation.components" <<External>> {
  class UserProfileBadge
}

package "ca.presentation.components" <<External>> {
  class NotificationBell
}

Layout --> LanguageSwitcher
Layout *-- NavigationSection
NavigationSection *-- NavigationOption
UndoToastOpener ..> UndoToast : opens
DateTimePipe ..> DateTimeFormat
RelativeTimePipe ..> DateTimeFormat
ElapsedTimePipe ..> DateTimeFormat
App *-- Layout
App --> IamStore
App ..> UserProfileBadge : projected into Layout
App ..> UserSessionSection : projected into Layout
App ..> NotificationBell : projected into Layout
appConfig ..> SIGNED_IN : provides IamStore.isSignedIn
appConfig ..> IamStore
note bottom of SidePanel
  Modal panel in an overlay: keeps the focus inside, closes with Escape, the close
  button or a click outside, and gives the focus back. The view decides what closing means.
end note
note bottom of UndoToast
  A few seconds to undo an action; the time stops under the pointer or the focus.
  Opening another toast closes the previous one, which ends as confirmed.
end note
note bottom of DateTimePipe
  Every date in the chosen language and the time zone of the laboratories.
end note
note bottom of Layout
  Wraps every page from app.html. The side menu only shows with operational
  access. Its options are grouped by how often the laboratory uses them, and an
  option stays active whatever the query parameters of the address. The logo and the name lead to /home without a session and to
  /dashboard with one. Menu labels only use nav.* keys:
  English Title Case, Spanish sentence case, "Catalog" spelling.
  App projects the notification bell (ca), profile badge (profile)
  and sign-out action (iam) into its slots, so shared imports no context.
  The badge photo and name open the profile.
  The layout keeps both user widgets inside one capsule. Up to 720px the brand is hidden
  so the user section stays complete; up to 480px the language switcher is
  compact (no check mark).
end note
NavigationOption *-- NavigationChild

Home ..> AuthenticationSection : route data, NgComponentOutlet
PageNotFound --> Router
PageNotFound --> SIGNED_IN
note bottom of SIGNED_IN
  Whether a user is signed in, read by shared views without importing IAM;
  false unless the composition root provides it.
end note

EnvironmentSelector ..> EnvironmentOption
note bottom of EnvironmentSelector
  Visual component without store: the views of inventory, products, alerts,
  telemetry and reports pass the environments of their own context.
end note

@enduml
