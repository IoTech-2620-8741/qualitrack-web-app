@startuml batch-frontend-diagram

title QualiTrack - Product Batch Management Frontend Class Diagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "shared" {
  class EnvironmentSelector <<component>>
  interface BaseEntity
  class BaseApi
  class BaseApiEndpoint
  interface BaseAssembler
  class "operations-page.css" as OperationsPage <<stylesheet>>
  class localIsoDate <<function>>
}

package "iam.application" {
  class IamStore {
    +requireLaboratoryId(): number
    +canManageQuality: Signal<boolean>
  }
}

package "shared.infrastructure" {
  class EnvironmentPreference {
    +choose(laboratoryId, environments, preferredUsage?)
    +remember(laboratoryId, environmentId): void
  }
}

package "batch.domain.model" {
  class ProductionEnvironment {
    +id / code / name
    +usage: string | null
  }
  class ProductionStaffMember {
    +id / fullName / role
    +active: boolean
    +accessRole: string | null
    +userId: number | null
    +assignable: boolean
  }
  class ConsumableRawMaterial {
    +id / name / unit
    +usableStock: number
  }
  class ConsumableLot {
    +id / rawMaterialId / batchNumber / unit
    +availableAmount: number
    +expiresOn: string
  }
  class ProductionEquipment {
    +id / name / serialNumber / status
    +deviceType: string | null
    +environmentId: number | null
    +isIotDevice / isOperational / isContainerMonitor
  }
  class PharmaceuticalProduct {
    +id: number
    +laboratoryId: number
    +environmentId: number | null
    +code: string
    +name: string
    +description: string | null
    +specifications: string
    +active: boolean
  }
  class Batch {
    +id: number
    +labId: number
    +environmentId: number | null
    +productId: number
    +productName: string
    +batchNumber: string
    +quantity: number
    +unit: string
    +status: BatchStatus
    +startDate: string
    +endDate?: string
    +notes?: string
    +containerMonitorId: number | null
    +isOpen: boolean
    +detailLink: route | null
  }
  class RawMaterialUsage
  interface EquipmentUsage
  interface StaffParticipation
  interface BatchTraceability {
    +batch: Batch
    +product
    +rawMaterials: TracedRawMaterialUsage[]
    +equipment: EquipmentUsage[]
    +staff: StaffParticipation[]
    +release: ReleaseEvidence | null
    +rejection: RejectionEvidence | null
    +container: BatchContainer | null
  }
  interface BatchContainer {
    +batchId: number
    +containerMonitorId: number
    +containerName: string | null
    +environmentId: number
    +assignedBy: number
    +assignedAt: string
  }
  interface BatchPath {
    +laboratoryId: number
    +environmentId: number
    +productId: number
  }
  interface CreateProductCommand
  interface CreateBatchCommand
  interface ReleaseBatchCommand
  interface RejectBatchCommand
  interface RegisterRawMaterialUsageCommand
}

PharmaceuticalProduct ..|> BaseEntity
Batch ..|> BaseEntity
BatchTraceability --> Batch
BatchTraceability --> EquipmentUsage
BatchTraceability --> StaffParticipation
BatchTraceability --> "0..1" BatchContainer

package "batch.infrastructure" {
  class ProductionEquipmentApiEndpoint {
    +getEquipment(laboratoryId)
  }
  class ProductionEquipmentAssembler
  class ProductionEnvironmentApiEndpoint {
    +getEnvironments(laboratoryId)
  }
  class ProductionEnvironmentAssembler
  class ProductionStaffMemberApiEndpoint {
    +getStaff(laboratoryId)
  }
  class ProductionStaffMemberAssembler
  class ConsumableStockApiEndpoint {
    +getRawMaterials(laboratoryId, environmentId)
    +getUsableLots(laboratoryId, environmentId, rawMaterialId)
  }
  class ConsumableStockAssembler
  class BatchApi {
    +getProducts(lab, environmentId)
    +getProduct(lab, environmentId, productId)
    +createProduct(lab, environmentId, request)
    +getBatches(lab)
    +getProductBatches(path)
    +getBatch(path, batchId)
    +createBatch(path, request)
    +releaseBatch(path, batchId, request)
    +rejectBatch(path, batchId, request)
    +registerRawMaterialUsage(path, batchId, request)
    +registerEquipmentUsage(path, batchId, equipmentId)
    +registerStaffParticipation(path, batchId, staffId)
    +getTraceability(path, batchId)
    +assignContainer(path, batchId, containerMonitorId)
    +getRawMaterialUsages(lab, environmentId, rawMaterialId)
    +getMaterialHistory(laboratoryId, legacyRawMaterialId)
  }
  class ProductApiEndpoint
  class BatchApiEndpoint
  class RawMaterialUsageApiEndpoint
  class ProductAssembler
  class BatchAssembler
  class RawMaterialUsageAssembler
}

BatchApi --|> BaseApi
BatchApi --> ProductApiEndpoint
BatchApi --> BatchApiEndpoint
BatchApi --> RawMaterialUsageApiEndpoint
ProductApiEndpoint --|> BaseApiEndpoint
BatchApiEndpoint --|> BaseApiEndpoint
RawMaterialUsageApiEndpoint --|> BaseApiEndpoint
ProductApiEndpoint --> ProductAssembler
BatchApiEndpoint --> BatchAssembler
RawMaterialUsageApiEndpoint --> RawMaterialUsageAssembler
ProductAssembler ..|> BaseAssembler
BatchAssembler ..|> BaseAssembler
RawMaterialUsageAssembler ..|> BaseAssembler
BatchApiEndpoint ..> BatchPath
note right of BatchApiEndpoint
  /laboratories/{laboratoryId}/environments/{environmentId}
  /products/{productId}/batches[/{batchId}[/releases|/rejections|
  /equipment-usages|/staff-participations|/traceability|
  /container-assignment (PUT)]]
end note

package "batch.application" {
  class BatchStore <<root>> {
    +batches: Signal<Batch[]>
    +productBatches: Signal<Batch[]>
    +selectedBatch: Signal<Batch>
    +traceability: Signal<BatchTraceability>
    +canDecide: Signal<boolean>
    +environments: Signal<ProductionEnvironment[]>
    +environmentsLoading / environmentsError / environmentsEmpty
    +loadEnvironments(): Promise<void>
    +preferredProductionEnvironment(): ProductionEnvironment | null
    +rememberProductionEnvironment(environmentId)
    +preferredStorageEnvironment(): ProductionEnvironment | null
    +loadStaff(): Promise<ProductionStaffMember[]>
    +loadBatches(labId)
    +findBatch(batchId): Promise<Batch | undefined>
    +loadProductBatches(path)
    +loadBatch(path, batchId)
    +createBatch(path, command)
    +releaseBatch(path, batchId, command)
    +rejectBatch(path, batchId, command)
    +registerEquipment(path, batchId, equipmentId)
    +registerStaff(path, batchId, staffId)
    +assignContainer(path, batchId, containerMonitorId)
    +products: Signal<PharmaceuticalProduct[]>
    +product: Signal<PharmaceuticalProduct>
    +canManageProducts: Signal<boolean>
    +loadProducts(environmentId)
    +loadProduct(environmentId, productId)
    +createProduct(environmentId, command)
    +consumptionMaterials / consumptionLots / consumptionLot
    +clearConsumption()
    +selectConsumptionEnvironment(environmentId)
    +selectConsumptionMaterial(materialId)
    +selectConsumptionLot(lotId)
    +consumeRawMaterial(path, batchId, amount): Promise<boolean>
  }
  class batchError <<function>>
}

BatchStore --> BatchApi
BatchStore --> IamStore
BatchStore --> EnvironmentPreference
note bottom of BatchStore
  Reuses the operationId while retrying the same consumption;
  Inventory decides lot eligibility and available stock.
  Remembers the production environment ("production") and reads the
  raw material storage remembered by Inventory ("inventory").
end note

package "batch.presentation" {
  class BatchHome
  class ProductCatalog
  class ProductForm
  class ProductDetail
  class BatchList
  class BatchForm
  class BatchDetail
  class BatchReleaseForm
  class BatchRejectForm
  class RawMaterialUsageComponent
  class BatchParticipants
  class BatchTraceabilityView
  class BatchStorage <<component>> {
    #storageAreas: Signal<StorageArea[]>
    #container: Signal<BatchContainer | null>
    #storeBatch(): Promise<void>
  }
  class BatchRedirect
  class BatchRoutes
}

BatchHome --> BatchStore
ProductCatalog --> BatchStore
ProductCatalog --> EnvironmentSelector
ProductForm --> BatchStore
ProductDetail --> BatchStore
BatchList --> BatchStore
BatchForm --> BatchStore
BatchDetail --> BatchStore
BatchDetail *-- RawMaterialUsageComponent
BatchDetail *-- BatchParticipants
BatchDetail *-- BatchTraceabilityView
BatchDetail *-- BatchStorage
BatchReleaseForm --> BatchStore
BatchRejectForm --> BatchStore
RawMaterialUsageComponent --> BatchStore
RawMaterialUsageComponent --> EnvironmentSelector
BatchParticipants --> BatchStore
BatchParticipants --> IamStore
note bottom of BatchParticipants
  Quality managers add any active operator; an operator can only assign themselves.
  Auditors only consult the batch (no usage or participation forms).
end note
BatchTraceabilityView --> BatchStore
BatchStorage --> BatchStore
BatchStorage --> IamStore
note bottom of BatchStorage
  Storage tab (US78, US79): operational container monitors grouped by
  PRODUCT_STORAGE environment; auditors only see the current container.
  "View container conditions" -> /tracking/history?environmentId=&deviceId=.
end note
BatchRedirect --> BatchStore
BatchForm ..> localIsoDate
BatchReleaseForm ..> localIsoDate
BatchRejectForm ..> localIsoDate
ProductCatalog ..> OperationsPage
BatchDetail ..> OperationsPage

note bottom of BatchRoutes
  /batches -> preferred production environment
  /batches/environments/:environmentId/products[/new|/:productId]
  .../products/:productId/batches/new
  .../batches/:batchId[/release|/reject]
  /batches/batch-list and /batches/batch-detail/:id (resolves the full path)
end note

BatchApi --> ProductionEquipmentApiEndpoint
ProductionEquipmentApiEndpoint --> ProductionEquipmentAssembler
ProductionEquipmentAssembler ..> ProductionEquipment
BatchStore ..> ProductionEquipment : loadProductionEquipment()
note bottom of ProductionEquipmentApiEndpoint
  Equipment -> Product Batch (Customer/Supplier):
  GET /laboratories/{id}/equipments in Batch's own model.
end note

BatchApi --> ProductionEnvironmentApiEndpoint
ProductionEnvironmentApiEndpoint --> ProductionEnvironmentAssembler
ProductionEnvironmentAssembler ..> ProductionEnvironment
BatchApi --> ProductionStaffMemberApiEndpoint
ProductionStaffMemberApiEndpoint --> ProductionStaffMemberAssembler
ProductionStaffMemberAssembler ..> ProductionStaffMember
BatchApi --> ConsumableStockApiEndpoint
ConsumableStockApiEndpoint --> ConsumableStockAssembler
ConsumableStockAssembler ..> ConsumableRawMaterial
ConsumableStockAssembler ..> ConsumableLot
note bottom of ProductionEnvironmentApiEndpoint
  Laboratory -> Product Batch (Customer/Supplier):
  GET /laboratories/{id}/environments and /staff in Batch's own models.
end note
note bottom of ConsumableStockApiEndpoint
  Inventory -> Product Batch (Customer/Supplier):
  GET .../environments/{id}/raw-materials and
  .../raw-materials/{id}/batches?usable=true in Batch's own models.
end note
note bottom of RawMaterialUsageApiEndpoint
  Product Batch owns consumption writes and history resources.
  Inventory reads the same resources through its own MaterialConsumption ACL;
  it no longer imports BatchApi or RawMaterialUsage.
end note

@enduml
