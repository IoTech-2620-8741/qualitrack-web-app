@startuml tracking-frontend-diagram
title QualiTrack - Tracking Frontend

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "shared" <<External>> {
  interface BaseEntity
  interface BaseResource
  interface BaseResponse
  interface BaseAssembler
  abstract class BaseApiEndpoint
}

package "iam" <<External>> {
  class IamStore {
    +requireLaboratoryId(): number
  }
}

package "equipment" <<External>> {
  class EquipmentStore {
    +iotDevices(): Equipment[]
    +loadEquipment(labId?: number): void
  }
}

package "tracking" {

  package "domain.model" {
    class Measurement {
      +id: number
      +equipmentId: number
      +parameterName: string
      +value: number
      +unit: string
      +timestamp: string
      +createdAt: string
    }

    enum DeviceConnectionStatus {
      CONNECTED
      REQUIRES_REVIEW
    }

    class DeviceConnection {
      +id: number
      +connectionStatus: DeviceConnectionStatus
      +lastCommunicationAt: string | null
      +expectedPeriodSeconds: number
      +isConnected: boolean
    }

    class TelemetryHistoryPoint {
      +id: number
      +equipmentId: number
      +parameterName: string
      +recordedValue: number
      +timestamp: string
      +isAnomaly: boolean
      +createdAt: string
    }
  }

  package "application" {
    class TrackingStore {
      -api: TrackingApi
      -iam: IamStore
      +measurements: Signal<Measurement[]>
      +deviceConnection: Signal<DeviceConnection | null>
      +telemetryHistory: Signal<TelemetryHistoryPoint[]>
      +isLoading: Signal<boolean>
      +error: Signal<string | null>
      +anomaliesHistory: Signal<TelemetryHistoryPoint[]>
      +loadLatestMeasurements(equipmentId: number): void
      +loadDeviceConnection(device: Equipment): void
      +loadTelemetryHistory(filters: TelemetryHistoryFilters): void
      +clearMessages(): void
    }

    class TelemetryHistoryFilters <<type>> {
      +equipmentId: number
      +from?: string
      +to?: string
    }
  }

  package "infrastructure" {
    interface MeasurementResource
    interface MeasurementsResponse
    interface DeviceConnectionResource {
      +deviceId: number
      +connectionStatus: string
      +lastCommunicationAt: string | null
      +expectedPeriodSeconds: number
    }
    interface DeviceConnectionsResponse
    interface TelemetryHistoryPointResource
    interface TelemetryHistoryResponse

    class MeasurementAssembler
    class DeviceConnectionAssembler
    class TelemetryHistoryAssembler

    class MeasurementApiEndpoint {
      +getLatestMeasurements(equipmentId: number): Observable<Measurement[]>
    }

    class DeviceConnectionApiEndpoint {
      +getConnection(laboratoryId, environmentId, deviceId): Observable<DeviceConnection>
    }

    class TelemetryHistoryApiEndpoint {
      +getTelemetryHistory(filters: TelemetryHistoryFilters): Observable<TelemetryHistoryPoint[]>
    }

    class TrackingApi {
      +getLatestMeasurements(equipmentId: number): Observable<Measurement[]>
      +getDeviceConnection(laboratoryId, environmentId, deviceId): Observable<DeviceConnection>
      +getTelemetryHistory(filters: TelemetryHistoryFilters): Observable<TelemetryHistoryPoint[]>
    }
  }

  package "presentation" {
    class TrackingRoutes <<Routes>> {
      +dashboard: TelemetryDashboardComponent
      +analysis: TelemetryChartComponent
      +history: TelemetryHistoryComponent
    }

    class TelemetryDashboardComponent {
      -selectedEquipmentId: Signal<number>
      -selectedDevice: Signal<Equipment | null>
      +onEquipmentChange(): void
    }

    class TelemetryChartComponent
    class TelemetryHistoryComponent
  }
}

Measurement --|> BaseEntity
DeviceConnection --|> BaseEntity
TelemetryHistoryPoint --|> BaseEntity
DeviceConnection --> DeviceConnectionStatus

MeasurementResource --|> BaseResource
DeviceConnectionResource --|> BaseResource
TelemetryHistoryPointResource --|> BaseResource
MeasurementsResponse --|> BaseResponse
DeviceConnectionsResponse --|> BaseResponse
TelemetryHistoryResponse --|> BaseResponse

MeasurementAssembler ..|> BaseAssembler
DeviceConnectionAssembler ..|> BaseAssembler
TelemetryHistoryAssembler ..|> BaseAssembler

MeasurementApiEndpoint --|> BaseApiEndpoint
DeviceConnectionApiEndpoint --|> BaseApiEndpoint
TelemetryHistoryApiEndpoint --|> BaseApiEndpoint

MeasurementApiEndpoint --> MeasurementAssembler
DeviceConnectionApiEndpoint --> DeviceConnectionAssembler
TelemetryHistoryApiEndpoint --> TelemetryHistoryAssembler

TrackingApi *-- MeasurementApiEndpoint
TrackingApi *-- DeviceConnectionApiEndpoint
TrackingApi *-- TelemetryHistoryApiEndpoint

TrackingStore --> TrackingApi
TrackingStore --> IamStore
TrackingStore ..> TelemetryHistoryFilters

TelemetryDashboardComponent --> TrackingStore
TelemetryDashboardComponent --> EquipmentStore
TelemetryChartComponent --> TrackingStore
TelemetryChartComponent --> EquipmentStore
TelemetryHistoryComponent --> TrackingStore
TelemetryHistoryComponent --> EquipmentStore

TrackingRoutes ..> TelemetryDashboardComponent
TrackingRoutes ..> TelemetryChartComponent
TrackingRoutes ..> TelemetryHistoryComponent

note right of DeviceConnectionApiEndpoint
  GET /laboratories/{laboratoryId}/environments/{environmentId}
      /devices/{deviceId}/telemetry-status (TS41)
  Measurements and history still use /equipments/{equipmentId}/...
  until the Tracking phase (environment and container monitor telemetry).
end note
note bottom of TelemetryDashboardComponent
  The tracking views list only IoT devices (environmental devices and
  container monitors); ordinary equipment sends no telemetry.
end note

@enduml
